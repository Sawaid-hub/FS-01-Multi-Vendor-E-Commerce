NODE_ENV=development
PORT=4000
# Use a replica-set URI for checkout transactions (Atlas URIs work; standalone mongod is insufficient).
MONGODB_URI=mongodb://127.0.0.1:27017/market-lane?replicaSet=rs0
# Use independent random values of at least 32 characters. Never use production payment credentials here.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Comma-separated browser origins allowed to call the API. Leave blank to disable cross-origin browser access.
CORS_ORIGINS=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5173
COMMISSION_BPS=1000
# Configure a reputable FX provider and check its freshness/terms before using the pilot.
FX_API_URL=https://api.frankfurter.dev/v1/latest
# Optional deterministic rates for local tests, e.g. {"USD":{"CAD":1.36,"GBP":0.79},"CAD":{"USD":0.74,"GBP":0.58},"GBP":{"USD":1.27,"CAD":1.72}}
FX_RATES_JSON=
# Leave unset until a Stripe account is configured in test mode. Live keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
# Shared cache/rate limits; optional for local development, required for production deployment.
# Production must use rediss:// (TLS). Obtain from Upstash, Render Redis, or similar.
REDIS_URL=
# Set to 0 only when your Redis provider uses self-signed TLS certificates (e.g. Upstash free tier).
# Leave blank or set to 1 to enforce certificate verification (recommended for production).
REDIS_TLS_REJECT_UNAUTHORIZED=
# Set to true to force Secure cookies in non-production environments (e.g. local HTTPS tunnel).
COOKIE_SECURE=
# MongoDB text search is the pilot default. Production deployment requires Elastic.
SEARCH_PROVIDER=mongodb
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=market-lane-products
# Email delivery mode: console (local dev) | gmail (Gmail OAuth2) | api (generic HTTP)
EMAIL_MODE=console
# Gmail OAuth2 — required when EMAIL_MODE=gmail.
# Step 1: fill in client ID and secret from Google Cloud Console (OAuth 2.0 credentials).
# Step 2: run `node src/scripts/get-gmail-token.js` to get the refresh token.
# Step 3: set GMAIL_SENDER to the Gmail address you authorised in the consent flow.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Generic HTTP delivery (e.g. SendGrid, Resend) — used when EMAIL_MODE=api.
EMAIL_DELIVERY_URL=
EMAIL_API_KEY=
# S3-compatible adapter, e.g. R2 for the pilot. Leave blank to use local server/uploads.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOADS_DIR=uploads
# Pilot seed is opt-in, development-only, and requires DEMO_PASSWORD of 12+ chars.
ALLOW_PILOT_SEED=false
DEMO_PASSWORD=
